@page
@using NexusCoreDotNet.Pages.Events
@model IndexModel
@{
    ViewData["Title"] = "Events";
}

<div class="page-header">
    <h2>Asset Status Events</h2>
    <p>Real-time Kafka stream of asset status changes across your organization</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h6 class="fw-semibold mb-0">
            <i class="bi bi-lightning-charge me-1 text-warning"></i> Status Change Log
        </h6>
        <span class="text-muted" style="font-size:.8rem;">@Model.Total event@(Model.Total == 1 ? "" : "s") total</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Events.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-lightning-charge fs-1 d-block mb-2"></i>
                <p class="mb-0">No events yet. Asset status changes will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Asset</th>
                            <th>Previous Status</th>
                            <th>New Status</th>
                            <th>Actor</th>
                            <th>Occurred At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in Model.Events)
                        {
                            <tr>
                                <td>
                                    <span class="fw-medium">@evt.AssetName</span>
                                    <div class="text-muted" style="font-size:.75rem;">@evt.AssetId</div>
                                </td>
                                <td>
                                    <span class="badge badge-@evt.PreviousStatus.ToLower().Replace("_", "_") rounded-pill">
                                        @evt.PreviousStatus.Replace("_", " ")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-@evt.NewStatus.ToLower().Replace("_", "_") rounded-pill">
                                        @evt.NewStatus.Replace("_", " ")
                                    </span>
                                </td>
                                <td class="text-muted" style="font-size:.85rem;">@evt.ActorId</td>
                                <td class="text-muted" style="font-size:.85rem;">
                                    @evt.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                    <span class="text-muted" style="font-size:.85rem;">
                        Page @Model.CurrentPage of @Model.TotalPages
                    </span>
                    <div class="d-flex gap-2">
                        @if (Model.CurrentPage > 1)
                        {
                            <a href="?page=@(Model.CurrentPage - 1)" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a href="?page=@(Model.CurrentPage + 1)" class="btn btn-sm btn-outline-secondary">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script>
    // Auto-refresh every 10 seconds to show new events
    setTimeout(() => location.reload(), 10000);
</script>
}
